{
  "name": "neurodoom",
  "version": "0.1.0",
  "description": "Cyberpunk immersive-sim FPS — visceral combat meets deep systemic simulation, in the browser",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "audit": "npm audit --audit-level=moderate",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1"
  }
}
